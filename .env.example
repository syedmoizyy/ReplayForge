DATABASE_URL=jdbc:postgresql://localhost:5432/replayforge
DATABASE_USER=replayforge
DATABASE_PASSWORD=replayforge
REDIS_HOST=localhost
REDIS_PORT=6379
REPLAYFORGE_INSTANCE_ID=local
REPLAY_CORE_THREADS=1
REPLAY_MAX_THREADS=4
REPLAY_QUEUE_CAPACITY=32
REPLAY_MAX_SOURCE_EVENTS=10000
REPLAY_RETRY_AFTER_SECONDS=5
WORKFLOW_STREAM=replayforge:workflow
WORKFLOW_DLQ_STREAM=replayforge:workflow:dlq
WORKFLOW_MAX_ATTEMPTS=4
WORKFLOW_INITIAL_BACKOFF_MS=100
WORKFLOW_POLL_DELAY_MS=250
WORKFLOW_CONSUMERS_ENABLED=true
